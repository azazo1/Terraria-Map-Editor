<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:TEdit5.ViewModels"
             xmlns:objects="using:TEdit.Terraria.Objects"
             mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="600"
             x:Class="TEdit5.Views.SpritePanelView"
             xmlns:ctl="using:TEdit5.Controls"
             x:CompileBindings="False">
    <UserControl.Resources>
        <ctl:TEditColorBrushConverter x:Key="StyleBrush" />
        <ctl:ItemIconConverter x:Key="SpriteIcon" />
    </UserControl.Resources>
    <!-- 移植自 TEdit/View/Sidebar/SpriteView2.xaml, 缩略图暂缺 -->
    <DockPanel Background="#2D2D2D">

        <TextBlock DockPanel.Dock="Top" Text="精灵" FontSize="16" FontWeight="SemiBold" Margin="8,6" />

        <Grid DockPanel.Dock="Top" Margin="4" ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0" Margin="2" PlaceholderText="搜索名字或方块编号"
                     Text="{Binding Sprites.SpriteFilter, Mode=TwoWay}" />
            <Button Grid.Column="1" Content="清除选择" Margin="2" Padding="8,4"
                    Command="{Binding Sprites.ClearSelectionCommand}" />
        </Grid>

        <TextBlock DockPanel.Dock="Top" Margin="6,0,6,4" Foreground="#AAAAAA" Text="{Binding Sprites.Summary}" />

        <Grid ColumnDefinitions="*,5,240">
            <ListBox Grid.Column="0" ItemsSource="{Binding Sprites.Sheets}"
                     SelectedItem="{Binding Sprites.SelectedSpriteSheet, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="objects:SpriteSheet">
                        <Grid ColumnDefinitions="20,*,Auto,60">
                            <Image Grid.Column="0" Width="16" Height="16" Margin="2" Stretch="Uniform"
                                   Source="{Binding Tile, Converter={StaticResource SpriteIcon}, ConverterParameter=Tile}" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="2" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Margin="4,2" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="11"
                                       Text="{Binding Tile, StringFormat='方块 {0}'}" />
                            <TextBlock Grid.Column="3" Margin="4,2" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="11"
                                       Text="{Binding Styles.Count, StringFormat='{}{0} 样式'}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <GridSplitter Grid.Column="1" Width="5" Background="#3F3F46" ResizeDirection="Columns" />

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Margin="4" FontWeight="Bold"
                           Text="{Binding Sprites.SelectedSpriteSheet.Name}" />
                    <Button DockPanel.Dock="Top" Content="定位到世界" Margin="6,4,6,2" Padding="6,3"
                            Command="{Binding Sprites.JumpToSpriteCommand}" />
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0">
                        <TextBlock Text="范围" VerticalAlignment="Center" Foreground="#AAAAAA" Margin="0,0,6,0" />
                        <NumericUpDown Minimum="8" Maximum="64" Increment="4" FormatString="0" Width="90"
                                       Value="{Binding Sprites.PreviewTiles, Mode=TwoWay}" />
                    </StackPanel>
                    <Image DockPanel.Dock="Top" Height="120" Width="120" Margin="6"
                           Stretch="Uniform" Source="{Binding Sprites.PreviewBitmap}" />
                <ListBox ItemsSource="{Binding Sprites.Styles}" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="objects:SpriteItem">
                            <Grid ColumnDefinitions="16,40,*" >
                                <Border Grid.Column="0" Width="12" Height="12" CornerRadius="2" Margin="2"
                                        Background="{Binding StyleColor, Converter={StaticResource StyleBrush}}" />
                                <TextBlock Grid.Column="1" Text="{Binding Style}" Width="40" Margin="2" Foreground="#AAAAAA" />
                                <TextBlock Grid.Column="2" Text="{Binding SizeTiles}" Margin="2" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
