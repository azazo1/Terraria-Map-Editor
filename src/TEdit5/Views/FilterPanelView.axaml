<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:TEdit5.ViewModels"
             xmlns:s="using:TEdit5.Services"
             mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="600"
             x:Class="TEdit5.Views.FilterPanelView"
             x:CompileBindings="False">
    <!-- 移植自 TEdit/View/Sidebar/FilterSidebarView.xaml -->
    <DockPanel Background="#2D2D2D">

        <TextBlock DockPanel.Dock="Top" Text="过滤" FontSize="16" FontWeight="SemiBold" Margin="8,6" />

        <StackPanel DockPanel.Dock="Bottom" Margin="8" Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="隐藏被过滤方块" VerticalAlignment="Center" />
                <ToggleSwitch IsChecked="{Binding Filter.HideFilteredTiles, Mode=TwoWay}" OnContent="" OffContent="" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="淡化" Width="72" VerticalAlignment="Center" />
                <Slider Width="180" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                        Value="{Binding Filter.DarkenAmount, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="去色" Width="72" VerticalAlignment="Center" />
                <Slider Width="180" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                        Value="{Binding Filter.DesaturateAmount, Mode=TwoWay}" />
            </StackPanel>

            <UniformGrid Columns="2">
                <Button Content="全选当前分类" Margin="2" Padding="6,4" Command="{Binding Filters.SelectAllCommand}" />
                <Button Content="清空全部" Margin="2" Padding="6,4" Command="{Binding Filters.ClearAllCommand}" />
            </UniformGrid>
        </StackPanel>

        <Grid DockPanel.Dock="Top" Margin="2" ColumnDefinitions="Auto,*,Auto,Auto">
            <TextBlock Grid.Column="0" Text="分类" VerticalAlignment="Center" Margin="4,0" />
            <ComboBox Grid.Column="1" Margin="2" HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Filters.CategoryNames}"
                      SelectedItem="{Binding Filters.SelectedCategory, Mode=TwoWay}" />
            <TextBlock Grid.Column="2" Text="搜索" VerticalAlignment="Center" Margin="4,0" />
            <TextBox Grid.Column="3" Width="120" Margin="2"
                     Text="{Binding Filters.FilterText, Mode=TwoWay}" />
        </Grid>

        <ListBox ItemsSource="{Binding Filters.Options}" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="s:FilterOption">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <CheckBox Grid.Column="0" Margin="2,0" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="2" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{Binding Id, StringFormat='[{0}]'}" Margin="4,2"
                                   VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="11" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
